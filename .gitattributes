# Preserve the exact bytes recorded in SHA-256 manifests, on every platform.
runtime/** -text
tools/** -text
updater/resources/** -text
*.ps1 -text
*.cjs -text
*.bat -text
runtime/pi/pi.exe filter=lfs diff=lfs merge=lfs -text
tools/node/node.exe filter=lfs diff=lfs merge=lfs -text
tools/git/ucrt64/bin/git-lfs.exe filter=lfs diff=lfs merge=lfs -text
tools/git/usr/share/misc/magic.mgc filter=lfs diff=lfs merge=lfs -text

*.py -text

*.yml -text

licenses/** -text
/.github/scripts/*.json -text

# Exclude bundled upstream software from this project's language statistics.
runtime/pi/** linguist-vendored
tools/node/** linguist-vendored
tools/git/** linguist-vendored
